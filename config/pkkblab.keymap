#define ZMK_POINTING_DEFAULT_MOVE_VAL 2500  // default: 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 40    // default: 10

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
        taptap: taptap {
            compatible = "zmk,behavior-hold-tap";
            label = "TAPTAP";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <180>;
            require-prior-idle-ms = <150>;
            flavor = "tap-preferred";
        };

        holdhold: holdhold {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLDHOLD";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            flavor = "tap-unless-interrupted";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <200>;
            retro-tap;
            quick-tap-ms = <180>;
        };

        momotap: momotap {
            compatible = "zmk,behavior-hold-tap";
            label = "MOMOTAP";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <180>;
            require-prior-idle-ms = <150>;
            flavor = "tap-preferred";
        };

        RAltCtrl: RAltCtrl {
            compatible = "zmk,behavior-tap-dance";
            label = "RALTCTRL";
            #binding-cells = <0>;
            bindings = <&lt 3 RALT>, <&kp RCTRL>;

            tapping-term-ms = <150>;
        };
    };

    combos {
        compatible = "zmk,combos";

        BS {
            bindings = <&kp BACKSPACE>;
            key-positions = <8 9>;
            timeout-ms = <100>;
            require-prior-idle-ms = <100>;
            layers = <0>;
        };

        BB {
            bindings = <&kp B>;
            key-positions = <25 26>;
            timeout-ms = <100>;
            layers = <0>;
            require-prior-idle-ms = <100>;
        };

        YY {
            bindings = <&kp Y>;
            key-positions = <3 4>;
            timeout-ms = <100>;
            layers = <0>;
            require-prior-idle-ms = <100>;
        };

        nn {
            bindings = <&kp N>;
            key-positions = <23 24>;
            timeout-ms = <100>;
            layers = <0>;
            require-prior-idle-ms = <100>;
        };

        CR {
            bindings = <&kp CAPSLOCK>;
            key-positions = <10 11>;
            layers = <0>;
        };

        ESCC {
            bindings = <&kp ESC>;
            key-positions = <0 1>;
            layers = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&mt TAB Q    &kp W           &kp E        &kp R        &kp T           &kp Y  &kp U        &kp I      &kp O    &kp P
&mt LCTRL A  &mt LEFT_ALT S  &mt LSHFT D  &lt 4 F      &mt LEFT_GUI G  &kp H  &kp J        &kp K      &kp L    &kp ENTER
&kp Z        &kp X           &kp C        &kp V        &kp B           &kp N  &kp M        &kp COMMA  &kp DOT  &mt RIGHT_SHIFT QUESTION
&none        &none           &lt 2 SPACE  &lt 1 SPACE  &none           &none  &lt 2 SPACE  &RAltCtrl  &none    &none
            >;
        };

        layer_1 {
            bindings = <
&kp N1    &kp NUMBER_2  &kp NUMBER_3  &kp N4     &kp N5  &kp N6            &kp N7             &kp N8         &kp N9    &kp N0
&kp LEFT  &kp UP_ARROW  &kp DOWN      &kp RIGHT  &kp F4  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp SEMICOLON  &kp APOS  &kp ENTER
&none     &none         &none         &none      &none   &none             &none              &none          &none     &kp RSHFT
&none     &none         &none         &none      &none   &none             &kp SPACE          &none          &none     &none
            >;
        };

        layer_2 {
            bindings = <
&kp EXCLAMATION  &kp AT_SIGN    &kp HASH   &kp DOLLAR            &kp PERCENT            &none    &kp KP_N7  &kp KP_N8  &kp KP_N9  &kp PLUS
&kp CARET        &kp AMPERSAND  &kp ASTRK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &none    &kp KP_N4  &kp KP_N5  &kp KP_N6  &kp MINUS
&kp TILDE        &none          &none      &kp SLASH             &kp NON_US_BACKSLASH   &kp DOT  &kp KP_N1  &kp KP_N2  &kp KP_N3  &kp ASTERISK
&none            &none          &none      &none                 &none                  &trans   &trans     &kp KP_N0  &none      &none
            >;
        };

        layer_3 {
            bindings = <
&bt BT_CLR  &bt BT_SEL 0  &ext_power EP_TOG  &sys_reset  &none  &none   &kp HOME  &kp END   &kp UP_ARROW  &kp DELETE
&none       &none         &none              &none       &none  &trans  &trans    &kp LEFT  &kp DOWN      &kp RIGHT
&none       &none         &none              &none       &none  &trans  &trans    &trans    &trans        &trans
&none       &none         &none              &none       &none  &trans  &trans    &trans    &none         &none
            >;
        };

        layer_4 {
            bindings = <
&kp F1           &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &kp F7  &kp F8  &kp F9   &kp F10
&kp PRINTSCREEN  &none   &none   &trans  &trans  &trans  &trans  &none   &kp F11  &kp F12
&trans           &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans   &trans
&trans           &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans   &trans
            >;
        };
    };
};
